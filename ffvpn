def completion_script(shell):
    return BASH_COMPLETION if shell == "bash" else FISH_COMPLETION


def cmd_completion(args):
    print(completion_script(args.shell), end="")
    return 0


# --- argument parsing -------------------------------------------------------


def add_data_dir(parser):
    # SUPPRESS keeps a value parsed before the subcommand from being reset.
    parser.add_argument(
        "-d",
        "--data-dir",
        metavar="DIR",
        default=argparse.SUPPRESS,
        help="data folder (default: auto-detect)",
    )


def build_parser():
    parser = argparse.ArgumentParser(
        prog="ffvpn",
        description="Command-line client for the Firefox VPN desktop app.",
    )
    parser.add_argument(
        "-d", "--data-dir", metavar="DIR", help="data folder (default: auto-detect)"
    )
    commands = parser.add_subparsers(dest="command", required=True)

    connect = commands.add_parser("connect", help="Connect to a location.")
    add_data_dir(connect)
    connect.add_argument(
        "location", nargs="?", help="location, code, or name (default: fastest)"
    )
    modes = connect.add_mutually_exclusive_group()
    modes.add_argument(
        "--proxy", action="store_true", help="local proxy only (no system proxy)"
    )
    modes.add_argument(
        "--system-proxy", action="store_true", help="set the GNOME system proxy"
    )
    modes.add_argument("--tun", action="store_true", help="use TUN mode")
    connect.set_defaults(func=cmd_connect)

    disconnect = commands.add_parser("disconnect", help="Disconnect the VPN.")
    add_data_dir(disconnect)
    disconnect.set_defaults(func=cmd_disconnect)

    ls = commands.add_parser("ls", help="List locations.")
    add_data_dir(ls)
    ls.add_argument("--codes", action="store_true", help="print codes only")
    ls.set_defaults(func=cmd_ls)

    account = commands.add_parser("account", help="Manage accounts.")
    add_data_dir(account)
    account_commands = account.add_subparsers(dest="account_command", required=True)

    account_ls = account_commands.add_parser("ls", help="List accounts.")
    add_data_dir(account_ls)
    account_ls.add_argument(
        "--names", action="store_true", help="print one account name per line"
    )
    account_ls.set_defaults(func=cmd_account_ls)

    account_usage = account_commands.add_parser("usage", help="Show account usage.")
    add_data_dir(account_usage)
    account_usage.set_defaults(func=cmd_account_usage)

    account_set = account_commands.add_parser("set", help="Switch the active account.")
    add_data_dir(account_set)
    account_set.add_argument("account", help="account id, email, or name")
    account_set.set_defaults(func=cmd_account_set)

    account_logout = account_commands.add_parser(
        "logout", help="Remove an account and its stored tokens."
    )
    add_data_dir(account_logout)
    account_logout.add_argument("account", nargs="?", help="account id, email, or name")
    account_logout.add_argument(
        "--yes", action="store_true", help="do not ask for confirmation"
    )
    account_logout.set_defaults(func=cmd_account_logout)

    account_login = account_commands.add_parser("login", help="Sign in to an account.")
    add_data_dir(account_login)
    account_login.add_argument("email", nargs="?", help="Firefox Account email")
    account_login.set_defaults(func=cmd_account_login)

    completion = commands.add_parser("completion", help="Print a shell completion script.")
    add_data_dir(completion)
    completion.add_argument("shell", choices=["bash", "fish"], help="shell to complete")
    completion.set_defaults(func=cmd_completion)

    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return args.func(args) or 0
    except FfvpnError as error:
        print(f"ffvpn: {error}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    except Exception as error:
        # The CLI should never show a traceback to the person running it.
        print(f"ffvpn: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
