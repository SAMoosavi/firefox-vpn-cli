                    ;;
                *)
                    COMPREPLY=( $(compgen -W "ls usage set logout login" -- "$cur") )
                    ;;
            esac
            ;;
        completion)
            COMPREPLY=( $(compgen -W "bash fish" -- "$cur") )
            ;;
        *)
            COMPREPLY=( $(compgen -W "connect disconnect ls account completion" -- "$cur") )
            ;;
    esac
}
complete -F _ffvpn ffvpn
"""

